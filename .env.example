# Configuration PREVENIX Assurances
# Copiez ce fichier vers .env.local et configurez les valeurs localement ou dans l'environnement de déploiement.
# Ne publiez jamais de fichier .env contenant des valeurs.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clés Supabase (Optionnel pour déploiement cloud Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# L'accès administrateur reste désactivé si l'une de ces variables est absente ou invalide.
# ADMIN_SECRET_KEY doit être aléatoire et comporter au moins 32 caractères.
# ADMIN_DEFAULT_PASSWORD doit comporter au moins 12 caractères.
ADMIN_SECRET_KEY=
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=
